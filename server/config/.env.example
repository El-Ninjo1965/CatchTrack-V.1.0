DB_CHARSET=utf8mb4

BOOTSTRAP_ADMIN_USERNAME=platform_admin
BOOTSTRAP_ADMIN_DISPLAY_NAME=Platform Administrator
BOOTSTRAP_ADMIN_PASSWORD=change-me-before-production
