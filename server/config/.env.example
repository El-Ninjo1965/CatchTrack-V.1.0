APP_ENV=production
PLATFORM_APP_NAME=Technical Web App Platform
PLATFORM_SESSION_NAME=platform_session
SESSION_SECURE=1
SESSION_LIFETIME=3600

DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=platform_db
DB_USER=platform_user
