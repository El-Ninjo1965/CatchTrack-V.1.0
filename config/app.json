{
    "app": {

        "name": "CatchTrack",

        "version": "1.0",

        "edition": "Master",

        "status": "development",

        "language": "de",

        "supportedLanguages": [

            "de",

            "en",

            "th",

            "fr",

            "es",

            "jp",

            "cn"

        ]

    },


    "system": {

        "mode": "offline",

        "offlineFirst": true,

        "cloudEnabled": false,

        "maintenanceMode": false

    },


    "database": {

        "type": "SQLite",

        "version": "1.0",

        "autoMigration": true,

        "backupEnabled": true

    },


    "modules": {

        "autoLoad": true,

        "autoDetect": true,

        "adminControl": true

    },


    "storage": {

        "localStorage": true,

        "backupPath": "Backup/",

        "exportPath": "Export/"

    },


    "security": {

        "authentication": false,

        "adminMode": false,

        "deviceLimit": 3

    },


    "cloud": {

        "provider": null,

        "syncEnabled": false,

        "syncInterval": 0

    },


    "development": {

        "debug": true,

        "logLevel": "info"

    }

}