# CatchTrack V1.0 - Git Ignore

# Operating System
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Environment / Secrets
.env
.env.*
!.env.example

# Dependencies
node_modules/

# Package Manager
.npm/
*.tgz
.npmrc.local

# Development Caches
.cache/
.vite/
.eslintcache
.stylelintcache
.nyc_output/
coverage/
*.lcov
*.tsbuildinfo

# Build Output
dist/
build/
out/

# Temporary Files
tmp/
temp/
*.tmp
*.temp

# Editor / IDE
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo

# Local Development Data
*.local

# Runtime Database Files
# Schema, migrations and seed files remain tracked.
# Only SQLite runtime sidecar files are ignored.
*.sqlite-shm
*.sqlite-wal
*.db-shm
*.db-wal

# Runtime / Process Files
*.pid
*.pid.lock
*.seed