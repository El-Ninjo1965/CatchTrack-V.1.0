{
    "id": "ai",

    "name": "AI Assistant",

    "version": "1.0.0",

    "description": "KI-Unterstützung zur Erkennung von Tieren, Pflanzen, Fischen und Objekten über externe KI-Assistenten.",

    "author": "CatchTrack",

    "category": "assistant",

    "enabled": false,

    "adminControl": true,

    "files": {
        "html": "ai.html",
        "js": "ai.js",
        "css": "ai.css"
    },

    "permissions": [
        "camera",
        "external_ai"
    ],

    "features": {

        "imageRecognition": true,

        "fishRecognition": true,

        "plantRecognition": true,

        "animalRecognition": true,

        "objectRecognition": true

    },

    "connection": {

        "mode": "external_assistant",

        "requiresApiKey": false,

        "requiresOwnModel": false

    },

    "privacy": {

        "askBeforeSending": true,

        "externalTransfer": true

    }

}