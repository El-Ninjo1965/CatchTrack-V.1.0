{
  "id": "waters",
  "name": "Waters",
  "version": "1.0.0",
  "description": "Erfassung und Verwaltung von Fangplätzen und Gewässerstandorten.",
  "entry": "app.js",
  "enabled": true,
  "features": {
    "gps": true,
    "automaticLocation": true,
    "reverseGeocoding": false,
    "waterNameManual": true,
